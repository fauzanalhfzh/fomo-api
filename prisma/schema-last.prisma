generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FacilityLevel {
  BANYAK
  ADA
  TIDAK_ADA
}

enum ToiletType {
  DUDUK
  JONGKOK
  CAMPURAN
}

enum GenderType {
  PRIA
  WANITA
  UNISEX
}

enum Atmosphere {
  TENANG
  NYAMAN
  HIDUP
  MODERAT
}

model User {
  id        String   @id
  email     String?  @unique
  alias     String?
  avatarUrl String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimedSpots Spot[]
  reviews      Review[]
}

model Spot {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  latitude    Float
  longitude   Float
  photoUrls   String[]
  fomoScore   Float    @default(0)
  isActive    Boolean  @default(true)
  claimedById String?

  priceMin   Int?
  priceMax   Int?
  openDays   String?
  openTime   String?
  closeTime  String?
  website    String?
  socialMedia Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimedBy User?      @relation(fields: [claimedById], references: [id])
  tags      SpotTag[]
  reviews   Review[]
  facility  SpotFacility?
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  spots SpotTag[]
}

model SpotTag {
  spotId String
  tagId  String
  spot   Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([spotId, tagId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  content   String?
  userId    String
  spotId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  spot Spot @relation(fields: [spotId], references: [id])
}

model SpotFacility {
  id        String         @id @default(cuid())
  spotId    String         @unique
  spot      Spot           @relation(fields: [spotId], references: [id], onDelete: Cascade)

  wifi      FacilityLevel  @default(TIDAK_ADA)
  wifiSpeed String?
  plugs     FacilityLevel  @default(TIDAK_ADA)
  comfyDesk FacilityLevel  @default(TIDAK_ADA)
  atmosphere Atmosphere?
  hasIndoor Boolean        @default(false)

  toiletLevel FacilityLevel @default(TIDAK_ADA)
  toilets     Toilet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Toilet {
  id              String      @id @default(cuid())
  facilityId      String
  facility        SpotFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  type            ToiletType
  gender          GenderType
  cleanliness     Int
  hasDisabled     Boolean     @default(false)
  hasBabyFacility Boolean     @default(false)
  hasMusholla     Boolean     @default(false)
  hasTissue       Boolean     @default(false)
  hasSoap         Boolean     @default(false)
  hasSanitizer    Boolean     @default(false)
  hasWastafel     Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
}
